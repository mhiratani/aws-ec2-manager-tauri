{
  "$schema": "https://tauri.app/schemas/capabilities/v1",
  "identifier": "main-capability",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-size",
    "core:webview:default",
    "core:path:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-mkdir",
    "fs:allow-create",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message"
  ]
}
